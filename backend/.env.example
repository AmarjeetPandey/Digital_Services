# Create four PostgreSQL databases and set each connection string separately.
CONTENT_DATABASE_URL=postgresql://user:password@host/content_db?sslmode=require
INQUIRIES_DATABASE_URL=postgresql://user:password@host/inquiries_db?sslmode=require
APPLICATIONS_DATABASE_URL=postgresql://user:password@host/applications_db?sslmode=require
CERTIFICATES_DATABASE_URL=postgresql://user:password@host/certificates_db?sslmode=require

# Optional: change the admin login defaults
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
